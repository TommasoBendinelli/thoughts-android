+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+MJPDFAnnot_SetReplyTo(FPDF_ANNOTATION annot,
+                      FPDF_ANNOTATION in_reply_to) {
+  CPDF_AnnotContext* reply_context =
+      CPDFAnnotContextFromFPDFAnnotation(annot);
+  CPDF_AnnotContext* parent_context =
+      CPDFAnnotContextFromFPDFAnnotation(in_reply_to);
+  if (!reply_context || !parent_context) {
+    return false;
+  }
+
+  RetainPtr<CPDF_Dictionary> reply_dict =
+      reply_context->GetMutableAnnotDict();
+  CPDF_Document* document = reply_context->GetPage()->GetDocument();
+  if (!reply_dict || !document ||
+      parent_context->GetPage()->GetDocument() != document) {
+    return false;
+  }
+
+  // FPDFPage_CreateAnnot() inserts new annotation dictionaries directly into
+  // /Annots. /IRT must be an indirect reference, so promote both annotations
+  // before linking them. Existing annotations are already indirect.
+  auto ensure_indirect = [document](CPDF_AnnotContext* context) {
+    RetainPtr<CPDF_Dictionary> dict = context->GetMutableAnnotDict();
+    if (dict->GetObjNum() != 0) {
+      return true;
+    }
+    CPDF_Page* page = context->GetPage()->AsPDFPage();
+    RetainPtr<CPDF_Array> annots = page ? page->GetMutableAnnotsArray() : nullptr;
+    if (!annots) {
+      return false;
+    }
+    for (size_t index = 0; index < annots->size(); ++index) {
+      if (annots->GetMutableDirectObjectAt(index).Get() == dict.Get()) {
+        annots->ConvertToIndirectObjectAt(index, document);
+        return dict->GetObjNum() != 0;
+      }
+    }
+    return false;
+  };
+  if (!ensure_indirect(parent_context) || !ensure_indirect(reply_context)) {
+    return false;
+  }
+
+  const CPDF_Dictionary* parent_dict = parent_context->GetAnnotDict();
+  reply_dict->SetNewFor<CPDF_Reference>("IRT", document,
+                                        parent_dict->GetObjNum());
+  reply_dict->SetNewFor<CPDF_Name>("RT", "Reply");
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+MJPDFAnnot_SetIconName(FPDF_ANNOTATION annot,
+                       FPDF_BYTESTRING icon_name) {
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (!context || !icon_name) {
+    return false;
+  }
+  RetainPtr<CPDF_Dictionary> dict = context->GetMutableAnnotDict();
+  if (!dict) {
+    return false;
+  }
+  dict->SetNewFor<CPDF_Name>("Name", icon_name);
+  return true;
+}
