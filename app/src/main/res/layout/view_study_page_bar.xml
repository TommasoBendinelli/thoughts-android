<!-- Study mode in the reader: the agent-note tools for the page on screen. A drawing tool opens the
     page in the note screen with that tool; Send sends the page as it is, with the comment. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/studyPageTools"
    android:layout_width="match_parent"
    android:background="?attr/colorSurfaceContainer"
    android:clickable="true"
    android:focusable="false"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <!-- During a review the bar folds into this button, above the card; it opens the full bar. -->
    <LinearLayout
        android:id="@+id/studyPageCollapsedRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/studyPageExpand"
            style="@style/Widget.Material3.Button.ElevatedButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/study_page_open_tools"
            app:icon="@drawable/ic_agent_note_outline" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/studyPageFull"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- The comment for the agent is typed here, under the note, so scrolling, drawing and
             numbering stay possible while it is open. It grows to four lines, then scrolls. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/studyPageCommentLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/studyPageCommentField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/agent_note_comment_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="4000"
                android:maxLines="4"
                android:minLines="1"
                android:scrollbars="vertical"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Folds the bar back into its button (only during a review). -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/studyPageCollapse"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/study_page_close_tools"
            android:padding="10dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_small_arrow_down"
            app:tint="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/studyPageToolGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studyPageScroll"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:contentDescription="@string/agent_note_scroll"
                app:icon="@drawable/ic_pan_tool"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studyPagePen"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:contentDescription="@string/agent_note_pen"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studyPageHighlighter"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:contentDescription="@string/agent_note_highlighter"
                app:icon="@drawable/ic_highlight"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studyPageEraser"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:contentDescription="@string/agent_note_eraser"
                app:icon="@drawable/ic_eraser"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studyPageNumber"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:contentDescription="@string/agent_note_number"
                app:icon="@drawable/ic_numbered_marker"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/studyPageSend"
            style="@style/Widget.Material3.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="96dp"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:backgroundTint="@color/agent_note_send_background"
            android:text="@string/agent_note_send"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/agent_note_send_background"
            app:icon="@drawable/ic_send"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:strokeWidth="0dp" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
