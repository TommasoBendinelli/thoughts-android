<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/commentEditorTitle" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/comment" android:textAppearance="?attr/textAppearanceHeadlineSmall" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/commentEditorActionFlag" style="@style/Widget.Material3.Button.TextButton" app:strokeWidth="0dp" app:backgroundTint="@android:color/transparent" android:backgroundTint="@android:color/transparent"
            android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp"
            android:padding="12dp" android:checkable="true" android:contentDescription="@string/comment_action_needed"
            app:icon="@drawable/ic_comment_flag_outline" app:iconSize="24dp" app:iconPadding="0dp"
            app:iconGravity="textStart" app:cornerRadius="12dp" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_weight="1" android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/commentEditorDocumentLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/overview_add_document"
            android:visibility="gone">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/commentEditorDocument"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/commentEditorTextLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/commentEditorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="8"
                android:minLines="4"
                android:hint="@string/comment_editor_hint" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/commentEditorOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView android:id="@+id/commentEditorLinkingAttempt"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textIsSelectable="true" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/commentEditorLinkingMethod"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textIsSelectable="true" android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/comment_color"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/commentEditorColorSwatches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp" />
            </HorizontalScrollView>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/overview_priority">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/commentEditorPriority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/commentEditorLocationSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/commentEditorLocationRemove"
                    style="@style/Widget.Material3.Button.TextButton" app:strokeWidth="0dp" app:backgroundTint="@android:color/transparent" android:backgroundTint="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/overview_location_remove"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/commentEditorNeutral" style="@style/Widget.Material3.Button.TextButton" app:strokeWidth="0dp" app:backgroundTint="@android:color/transparent" android:backgroundTint="@android:color/transparent"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/commentEditorOptionsToggle" style="@style/Widget.Material3.Button.TextButton" app:strokeWidth="0dp" app:backgroundTint="@android:color/transparent" android:backgroundTint="@android:color/transparent"
            android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="0dp"
            android:paddingHorizontal="4dp" android:text="@string/comment_editor_details"
            app:icon="@drawable/ic_small_arrow_right" app:iconGravity="textStart" app:iconPadding="4dp" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/commentEditorCancel" style="@style/Widget.Material3.Button.TextButton" app:strokeWidth="0dp" app:backgroundTint="@android:color/transparent" android:backgroundTint="@android:color/transparent"
            android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="0dp"
            android:paddingHorizontal="12dp" android:text="@string/cancel" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/commentEditorSave" style="@style/Widget.Material3.Button" app:strokeWidth="0dp" app:backgroundTint="?attr/colorPrimary" android:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary"
            android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="72dp"
            android:text="@string/save" android:layout_marginStart="4dp" app:cornerRadius="24dp" />
    </LinearLayout>
</LinearLayout>
