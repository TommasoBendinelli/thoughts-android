<!-- Only the fields scroll: Cancel and Apply/Next stay pinned below them, so the keyboard
     shrinks the fields and never pushes the buttons out of sight. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
<ScrollView android:id="@+id/fieldsScroll"
    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="20dp"
        android:paddingEnd="20dp" android:paddingBottom="4dp"
        android:focusableInTouchMode="true">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/review_again_in" android:textSize="20sp"
            android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/timingPrompt" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBody1" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp">
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/amountLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                app:hintEnabled="false" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/amount"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:inputType="numberDecimal" android:singleLine="true" android:selectAllOnFocus="true"
                    android:hint="@string/review_interval_decimal_hint" android:textSize="22sp"
                    android:gravity="center" android:padding="8dp" android:imeOptions="actionDone"
                    android:contentDescription="@string/review_interval_amount" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="0dp" android:layout_weight="1.35" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" app:hintEnabled="false"
                app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/unit"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:inputType="none" android:singleLine="true" android:textSize="18sp"
                    android:paddingStart="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:contentDescription="@string/review_interval_unit" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <TextView android:id="@+id/due" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textAppearance="?attr/textAppearanceBody2"
            android:accessibilityLiveRegion="polite" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/pickDate"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:paddingStart="0dp" android:paddingEnd="8dp" android:textAllCaps="false" android:letterSpacing="0"
                app:strokeWidth="0dp" android:text="@string/review_interval_date_link" />
            <!-- Skip only: a random date, 2 days or later (95% within 14 days). -->
            <com.google.android.material.button.MaterialButton android:id="@+id/randomSkipDate"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginStart="8dp" android:insetTop="0dp" android:insetBottom="0dp"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:textAllCaps="false" android:letterSpacing="0"
                app:strokeWidth="0dp" android:text="@string/review_skip_random"
                android:contentDescription="@string/review_skip_random_description" android:visibility="gone" />
        </LinearLayout>
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/reviewNever"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/review_action_never" android:visibility="gone" />
        <LinearLayout android:id="@+id/reviewTagsContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/review_tags_title" android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/reviewTags"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="0dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/reviewScopeContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone" android:layout_marginTop="8dp">
            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/reviewApplyAll"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/review_apply_all_cards" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/reviewScopePickerLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="220dp" android:layout_height="wrap_content"
                android:layout_marginStart="48dp" android:visibility="gone"
                app:hintEnabled="false" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/reviewScopePicker"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:inputType="none" android:singleLine="true" android:cursorVisible="false"
                    android:textSize="16sp" android:paddingStart="12dp"
                    android:contentDescription="@string/review_scope_picker_description" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/reviewScopeDetail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingStart="16dp"
                android:textAppearance="?attr/textAppearanceCaption" android:visibility="gone" />
            <TextView android:id="@+id/reviewProjectUnavailable" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingStart="16dp"
                android:text="@string/review_skip_project_unavailable"
                android:textAppearance="?attr/textAppearanceCaption" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/skipWhichCardsContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/review_skip_which_cards" android:textAppearance="?attr/textAppearanceSubtitle2" />
            <RadioGroup android:id="@+id/skipWhichCards" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:checkedButton="@id/skipDueOnly">
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/skipDueOnly"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="@string/review_skip_due_only" />
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/skipAllCards"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="@string/review_skip_all_cards" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="end" android:paddingStart="20dp"
        android:paddingTop="8dp" android:paddingEnd="20dp" android:paddingBottom="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:letterSpacing="0"
            app:strokeWidth="0dp" android:text="@string/cancel" />
        <com.google.android.material.button.MaterialButton android:id="@+id/apply"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp"
            android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:letterSpacing="0"
            app:strokeWidth="0dp" app:cornerRadius="24dp" app:backgroundTint="?attr/colorPrimary" android:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary" android:text="@string/review_interval_apply" />
    </LinearLayout>
</LinearLayout>
