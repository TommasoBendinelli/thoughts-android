<?xml version="1.0" encoding="utf-8"?>
<!-- Written for MJ PDF. License is GPLv3. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sourceEditorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/sourceToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/sourceStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:paddingVertical="8dp"
            android:text="@string/source_editor_resolving"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>

    <!-- Conflict mode only: which text is shown, and what each choice means. -->
    <LinearLayout
        android:id="@+id/sourceConflictHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/sourceConflictTabs"
            style="@style/Widget.Material3.TabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:tabGravity="fill"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabMode="fixed"
            app:tabSelectedTextColor="?attr/colorOnSurface"
            app:tabTextColor="?attr/colorOnSurfaceVariant">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/source_conflict_tab_resolve" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/source_conflict_tab_fedora" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/source_conflict_tab_phone" />
        </com.google.android.material.tabs.TabLayout>

        <TextView
            android:id="@+id/sourceConflictTabDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/sourceConflictProgressLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/sourceConflictProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="?attr/colorSurfaceVariant"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp" />

        <LinearLayout
            android:id="@+id/sourceConflictNavigator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sourceConflictPosition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/sourceConflictLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sourcePreviousConflict"
                style="@style/SourceConflictIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/source_conflict_previous"
                app:icon="@drawable/ic_chevron_left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sourceNextConflict"
                style="@style/SourceConflictIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/source_conflict_next"
                app:icon="@drawable/ic_chevron_right" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/sourceScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/sourceScrollBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Conflict mode, Resolve tab: one conflict at a time, as a choice between versions. -->
            <LinearLayout
                android:id="@+id/sourceConflictGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/sourceConflictCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/sourceConflictMalformed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/source_conflict_notice_background"
                        android:padding="12dp"
                        android:text="@string/source_conflict_malformed_explanation"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnErrorContainer"
                        android:visibility="gone" />

                    <!-- Fedora's side. -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/sourceConflictFedoraPanel"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="@color/source_conflict_fedora_background"
                        app:strokeColor="@color/source_conflict_fedora_marker">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/sourceConflictFedoraTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/source_conflict_on_fedora"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="@color/source_conflict_fedora_text"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/sourceFedoraModifiedAt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/source_conflict_fedora_text" />

                            <TextView
                                android:id="@+id/sourceConflictFedoraText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:breakStrategy="simple"
                                android:fontFamily="monospace"
                                android:lineSpacingExtra="2dp"
                                android:textColor="?attr/colorOnSurface"
                                android:textIsSelectable="true"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sourceUseFedora"
                                style="@style/SourceConflictFilledButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:minHeight="48dp"
                                android:text="@string/source_conflict_keep_fedora" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- This phone's side. -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/sourceConflictPhonePanel"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="@color/source_conflict_phone_background"
                        app:strokeColor="@color/source_conflict_phone_marker">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/sourceConflictPhoneTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/source_conflict_on_phone"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="@color/source_conflict_phone_text"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/sourcePhoneModifiedAt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/source_conflict_phone_text" />

                            <TextView
                                android:id="@+id/sourceConflictPhoneText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:breakStrategy="simple"
                                android:fontFamily="monospace"
                                android:lineSpacingExtra="2dp"
                                android:textColor="?attr/colorOnSurface"
                                android:textIsSelectable="true"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sourceUsePhone"
                                style="@style/SourceConflictFilledButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:minHeight="48dp"
                                android:text="@string/source_conflict_keep_phone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:id="@+id/sourceConflictMoreActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sourceKeepBoth"
                            style="@style/SourceConflictOutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="@string/source_conflict_keep_both" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sourceEditConflict"
                            style="@style/SourceConflictOutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="@string/source_conflict_edit_manually"
                            app:icon="@drawable/ic_edit" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sourceKeepBothHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/source_conflict_keep_both_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- Shown by "Edit manually": write this conflict's final text. -->
                    <LinearLayout
                        android:id="@+id/sourceConflictManualEditor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/source_conflict_manual_title"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/source_conflict_manual_explanation"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/source_conflict_manual_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/sourceConflictManualText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:gravity="top|start"
                                android:inputType="textMultiLine|textNoSuggestions"
                                android:minLines="3"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sourceConflictManualCancel"
                                style="@style/SourceConflictTextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/cancel" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sourceConflictManualApply"
                                style="@style/SourceConflictFilledButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minHeight="48dp"
                                android:text="@string/source_conflict_manual_apply" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Every conflict is resolved: say so, and show the result below. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/sourceConflictDoneCard"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/source_conflict_phone_background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_conflict_resolved"
                            app:tint="@color/source_conflict_phone_marker" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/source_conflict_done_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/source_conflict_phone_text" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/source_conflict_done_message"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="@color/source_conflict_phone_text" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sourceShowRawText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/source_conflict_show_raw"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/sourceShowRawTextHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/source_conflict_show_raw_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sourceContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="32dp">

                <com.gitlab.mudlej.MjPdfReader.ui.source.SourceLineNumberGutter
                    android:id="@+id/sourceLineNumbers"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?attr/colorSurfaceVariant"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <com.gitlab.mudlej.MjPdfReader.ui.source.SourceEditText
                    android:id="@+id/sourceEditor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:breakStrategy="simple"
                    android:gravity="top|start"
                    android:hyphenationFrequency="none"
                    android:inputType="textMultiLine"
                    android:lineSpacingExtra="2dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/sourceSaveActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/sourceSaveDivider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sourceSaveHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sourceDiscardConflict"
                style="@style/SourceConflictOutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/source_conflict_discard"
                android:textColor="@color/source_conflict_destructive_text"
                android:visibility="gone"
                app:strokeColor="@color/source_conflict_destructive_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sourceSave"
                style="@style/SourceConflictFilledButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/save" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
