<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/contents_sheet_background"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/reviewCardsTitle"
            android:text="@string/review_cards_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/reviewCardsResize"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/contents_expand_panel"
            android:padding="14dp"
            android:src="@drawable/ic_fullscreen_grey"
            app:tint="?attr/colorOnSurfaceVariant" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/reviewCardsClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="14dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
        <!-- Selection mode (long press on a card): "N selected" and Cancel. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewCardsCancelSelection"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            app:strokeWidth="0dp"
            app:backgroundTint="@android:color/transparent"
            android:text="@string/cancel"
            android:contentDescription="@string/review_cards_sheet_cancel_selection"
            android:visibility="gone" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/reviewCardsProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal" />
    <TextView
        android:id="@+id/reviewCardsMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reviewCardsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:nestedScrollingEnabled="false"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="vertical" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">
        <!-- Retired (N): the cards retired on this document, listed apart; back to the PDF's cards. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewCardsRetired"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <!-- Selection mode: merge the selected cards into one. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewCardsMerge"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
