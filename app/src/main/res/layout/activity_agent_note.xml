<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/agentNoteToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:titleTextAppearance="?attr/textAppearanceTitleMedium" />

    <!-- The reader's open-document tabs: this notes window is one of them, so the PDFs are one tap away. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/agentNoteTabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="?attr/colorSurfaceContainerHigh"
        android:contentDescription="@string/open_document_tabs"
        android:visibility="gone"
        app:tabGravity="start"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="2dp"
        app:tabMaxWidth="180dp"
        app:tabMinWidth="72dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="12dp"
        app:tabPaddingStart="12dp"
        app:tabRippleColor="?attr/colorSurfaceVariant"
        app:tabSelectedTextColor="?attr/colorOnSurface"
        app:tabTextAppearance="@style/TextAppearance.Material3.LabelLarge"
        app:tabTextColor="?attr/colorOnSurfaceVariant" />

    <!-- Who answers a reply to this note, always in view under its title: a state mark, whether an
         agent listens and which, and Change to choose another (server agent_note_answer_by_v1).
         While nobody listens it has the warning look, and Open conversation continues the
         conversation that sent the note. -->
    <LinearLayout
        android:id="@+id/agentNoteAnswerLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/agentNoteAnswerMark"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_overview_filter_check" />

        <TextView
            android:id="@+id/agentNoteAnswerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="6dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />

        <Button
            android:id="@+id/agentNoteOpenConversation"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/proposal_open_conversation"
            android:visibility="gone" />

        <Button
            android:id="@+id/agentNoteAnswerChange"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/agent_note_answer_change"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The note's message: one line while collapsed, all of it while expanded; a tap on it or on the
         chevron switches, and the choice holds for the next notes, so the picture keeps the room. -->
    <LinearLayout
        android:id="@+id/agentNoteMessageRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agentNoteMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />

        <!-- Invisible (never gone) when the message fits on one line, so the text width never changes. -->
        <ImageView
            android:id="@+id/agentNoteMessageToggle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_small_arrow_down"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFE6E6E6">

        <com.gitlab.mudlej.MjPdfReader.ui.agentnotes.AnnotationCanvasView
            android:id="@+id/agentNoteCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/agent_note_canvas_description" />

        <ProgressBar
            android:id="@+id/agentNoteProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/agentNoteStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/agentNoteTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <!-- Who answers the reply: one slim line over the comment. The whole line is the touch target
             and opens the choice of agent (the chip shows its pressed state). What an agent may use is
             chosen when its session starts (New session). Not for a page from the reader. -->
        <FrameLayout
            android:id="@+id/agentNoteAnsweredByRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="36dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <com.google.android.material.chip.Chip
                android:id="@+id/agentNoteAnsweredBy"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:clickable="false"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:focusable="false"
                android:importantForAccessibility="noHideDescendants"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                app:chipIcon="@drawable/ic_agent_conversation"
                app:chipIconSize="16dp"
                app:chipIconTint="?attr/colorOnSurfaceVariant"
                app:chipMinHeight="28dp"
                app:closeIcon="@drawable/ic_small_arrow_down"
                app:closeIconSize="18dp"
                app:closeIconTint="?attr/colorOnSurfaceVariant"
                app:closeIconVisible="true"
                app:ensureMinTouchTargetSize="false" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- The comment for the agent is typed here, under the note, so scrolling, drawing and
                 numbering stay possible while it is open. It grows to four lines, then scrolls. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/agentNoteCommentLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/agentNoteCommentField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/agent_note_comment_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="4000"
                    android:maxLines="4"
                    android:minLines="1"
                    android:scrollbars="vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/agentNoteUndo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/agent_note_undo"
                android:src="@drawable/ic_undo"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/agentNoteRedo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/agent_note_redo"
                android:src="@drawable/ic_redo"
                app:tint="?attr/colorOnSurface" />

            <!-- Send with picture: a photo from the glasses goes with the comment and drawing, so the
                 agent that sent the note gets the words and the picture together. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/agentNoteSendWithPicture"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:backgroundTint="@color/agent_note_send_background"
                android:contentDescription="@string/agent_note_send_with_picture"
                android:tooltipText="@string/agent_note_send_with_picture"
                android:visibility="gone"
                app:backgroundTint="@color/agent_note_send_background"
                app:icon="@drawable/ic_photo_camera"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@android:color/white"
                app:strokeWidth="0dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/agentNoteToolGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/agentNoteScroll"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:contentDescription="@string/agent_note_scroll"
                    app:icon="@drawable/ic_pan_tool"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/agentNotePen"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:contentDescription="@string/agent_note_pen"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/agentNoteHighlighter"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:contentDescription="@string/agent_note_highlighter"
                    app:icon="@drawable/ic_highlight"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/agentNoteEraser"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:contentDescription="@string/agent_note_eraser"
                    app:icon="@drawable/ic_eraser"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/agentNoteNumber"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:contentDescription="@string/agent_note_number"
                    app:icon="@drawable/ic_numbered_marker"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/agentNoteSend"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="96dp"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:backgroundTint="@color/agent_note_send_background"
                android:text="@string/agent_note_send"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/agent_note_send_background"
                app:icon="@drawable/ic_send"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@android:color/white"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
