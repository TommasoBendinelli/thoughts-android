<!-- A slider tag group in the tag sheet: a header (arrow, name, chosen step and tags while closed)
     that opens and closes the group, Edit slider, note and menu; open: the steps' track with their
     labels under the ticks; then, under a "Tags" caption, the group's free tags as chips with New
     tag; the note when opened. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:minHeight="48dp" android:orientation="horizontal">
        <!-- Tapping the arrow, name or summary opens or closes the group. -->
        <LinearLayout android:id="@+id/reviewTagScaleHeading"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:baselineAligned="false"
            android:clickable="true" android:focusable="true"
            android:gravity="center_vertical" android:minHeight="48dp" android:orientation="horizontal">
            <ImageView android:id="@+id/reviewTagScaleExpand"
                android:layout_width="24dp" android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_small_arrow_down"
                app:tint="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/reviewTagScaleName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end" android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />
            <!-- While closed: " · " and the step and tags chosen in the group. -->
            <TextView android:id="@+id/reviewTagScaleSummary"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_weight="1"
                android:ellipsize="end" android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/reviewTagScaleEditButton"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/review_tag_scale_edit"
            android:padding="10dp" android:scaleType="centerInside"
            android:src="@drawable/ic_edit"
            app:tint="?attr/colorOnSurfaceVariant" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/reviewTagScaleNoteButton"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="11dp" android:scaleType="centerInside"
            android:src="@drawable/ic_comment_add"
            app:tint="?attr/colorOnSurfaceVariant" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/reviewTagScaleMenu"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp" android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
    <!-- What the group holds, as wide as the sheet (the steps need the room); gone while the group is closed. -->
    <LinearLayout android:id="@+id/reviewTagScaleBody"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.gitlab.mudlej.MjPdfReader.ui.reader.ReviewScaleTrack android:id="@+id/reviewTagScaleTrack"
            android:layout_width="match_parent" android:layout_height="28dp"
            android:focusable="true" />
        <!-- One equal-width cell per step, so each label sits under its tick. -->
        <LinearLayout android:id="@+id/reviewTagScaleLabels"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" />
        <TextView android:id="@+id/reviewTagScaleEmpty"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/review_tag_scale_no_steps"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
        <!-- The group's tags are apart from the slider: shown only when the group has tag chips. -->
        <TextView android:id="@+id/reviewTagScaleTagsCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/review_tag_scale_tags_caption"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/reviewTagScaleChips"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="0dp" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/reviewTagScaleNoteLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/reviewTagScaleNote"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:minLines="2" android:maxLines="4"
                android:scrollbars="vertical" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="?attr/colorOutlineVariant" />
</LinearLayout>
