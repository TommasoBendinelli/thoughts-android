<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <View
            android:id="@+id/overviewDetailHandle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/comment_detail_handle"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/overviewCommentContents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:textSize="23sp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/overviewDetailMetadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/overviewDetailAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/overviewDetailCommentColor"
                android:layout_width="16dp"
                android:layout_height="16dp" />

            <TextView
                android:id="@+id/overviewDetailCommentSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <ImageView
                android:id="@+id/overviewDetailAnchorIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_link"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/overviewDetailAnchorStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/overviewDetailLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/overviewDetailSelectedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/overviewProposalDecisionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overviewDetailAttachments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/note_attachments" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overviewDetailHideUntil"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/todo_hide_until"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overviewOpenChatGpt"
            android:backgroundTint="@android:color/transparent"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/open_chatgpt"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overviewOpenComment"
                android:backgroundTint="@color/comment_detail_primary_background"
                app:backgroundTint="@color/comment_detail_primary_background"
                android:textColor="@color/comment_detail_primary_text"
                app:strokeWidth="0dp"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/overview_open_comment"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overviewEditComment"
                android:backgroundTint="@android:color/transparent"
                app:backgroundTint="@android:color/transparent"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/edit"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overviewDeleteComment"
                android:backgroundTint="@android:color/transparent"
                app:backgroundTint="@android:color/transparent"
                app:strokeWidth="0dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/delete"
                android:textColor="?attr/colorError" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overviewRestoreAnchor"
                android:backgroundTint="@android:color/transparent"
                app:backgroundTint="@android:color/transparent"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/overview_restore_anchor_description"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/overview_restore_anchor"
                android:visibility="gone"
                app:cornerRadius="28dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overviewDisregardProposal"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agent_proposal_disregard"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overviewAcceptProposal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agent_proposal_accept"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
