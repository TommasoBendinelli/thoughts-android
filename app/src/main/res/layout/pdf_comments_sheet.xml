<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/contents_sheet_background"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">
        <TextView
            android:id="@+id/commentsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/comments_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/commentsOptions"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/comments_options"
            android:padding="14dp"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurfaceVariant" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/commentsResize"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/comments_expand_panel"
            android:padding="14dp"
            android:src="@drawable/ic_fullscreen_grey"
            app:tint="?attr/colorOnSurfaceVariant" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/commentsClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="14dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
        <!-- Selection mode (Agent edits): "N selected", Select all, Cancel. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/commentsSelectAll"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            app:strokeWidth="0dp"
            app:backgroundTint="@android:color/transparent"
            android:text="@string/agent_edits_select_all"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/commentsCancelSelection"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            app:strokeWidth="0dp"
            app:backgroundTint="@android:color/transparent"
            android:text="@string/cancel"
            android:contentDescription="@string/agent_edits_cancel_selection"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/commentsSelectionActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/commentsRejectSelected"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/agent_edits_reject" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/commentsAcceptSelected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/agent_proposal_accept" />
    </LinearLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/commentsSearchLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:hint="@string/comments_search"
        app:endIconMode="clear_text">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/commentsSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout
        android:id="@+id/commentsBrowser"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
    <ProgressBar
        android:id="@+id/commentsProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal" />
    <TextView
        android:id="@+id/commentsMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/commentsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:nestedScrollingEnabled="false"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="vertical" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/commentsDetailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">
            <!-- Back to the list, and ‹ › to the previous or next item of the list as shown. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/commentsBack"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/comments_back_to_list"
                    app:strokeWidth="0dp"
                    app:backgroundTint="@android:color/transparent"
                    app:icon="@drawable/ic_chevron_left" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/commentsPrevious"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/previous_comment"
                    android:padding="12dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="?attr/colorOnSurface" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/commentsNext"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/next_comment"
                    android:padding="12dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>
            <TextView
                android:id="@+id/commentsDetailMetadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <LinearLayout
                android:id="@+id/commentsOriginalPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proposal_tex_changes"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />
                <TextView
                    android:id="@+id/commentsSourceFilename"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:fontFamily="monospace" />
                <TextView
                    android:id="@+id/commentsTexDiff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="10dp"
                    android:background="?attr/colorSurfaceVariant"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:maxLines="10"
                    android:ellipsize="end"
                    android:textIsSelectable="true" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/commentsEditSource"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    app:strokeWidth="0dp"
                    app:backgroundTint="@android:color/transparent"
                    android:text="@string/proposal_edit_source" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/commentsOpenConversation"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    app:strokeWidth="0dp"
                    app:backgroundTint="@android:color/transparent"
                    android:text="@string/proposal_open_conversation"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/commentsProposalReason"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/agent_original_why"
                    app:strokeWidth="0dp"
                    app:backgroundTint="@android:color/transparent"
                    app:icon="@drawable/ic_small_arrow_down" />
            </LinearLayout>
            <TextView
                android:id="@+id/commentsDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textIsSelectable="true" />
            <TextView
                android:id="@+id/commentsSelectedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="italic"
                android:textIsSelectable="true" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/commentsOpenThread"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comments_open_thread"
                app:strokeWidth="0dp"
                app:backgroundTint="@android:color/transparent" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/commentsProposalActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/commentsProposalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/commentsDisregardProposal"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/agent_original_disregard" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/commentsAcceptProposal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/agent_proposal_accept" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
