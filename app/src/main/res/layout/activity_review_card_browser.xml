<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/reviewCardBrowserProgress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/reviewCardBrowserSelectionControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reviewCardBrowserProgress">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewCardBrowserSelectAll"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/review_card_browser_select_all" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewCardBrowserRetire"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:visibility="gone"
            android:text="@string/review_card_browser_retire" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewCardBrowserRestore"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:visibility="gone"
            android:text="@string/review_card_browser_restore" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewCardBrowserDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/review_card_browser_delete" />
    </LinearLayout>

    <TextView
        android:id="@+id/reviewCardBrowserSelectionCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reviewCardBrowserSelectionControls" />

    <!-- Columns are as wide as their longest word; when they do not fit, the table scrolls sideways. -->
    <HorizontalScrollView
        android:id="@+id/reviewCardBrowserTable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reviewCardBrowserSelectionCount">

        <LinearLayout
            android:id="@+id/reviewCardBrowserTableContent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/reviewCardBrowserColumnHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:elevation="1dp"
                android:orientation="horizontal"
                android:paddingHorizontal="0dp"
                android:paddingVertical="10dp"
                android:visibility="visible"
                tools:visibility="visible">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/reviewCardBrowserHeaderCreated"
                    android:text="@string/review_card_browser_created"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/reviewCardBrowserHeaderLastReviewed"
                    android:text="@string/review_card_browser_last_reviewed"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/reviewCardBrowserHeaderQuestion"
                    android:text="@string/review_card_browser_question"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/reviewCardBrowserHeaderDue"
                    android:text="@string/review_card_browser_due"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/reviewCardBrowserHeaderDeck"
                    android:text="@string/review_card_browser_deck"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/reviewCardBrowserHeaderDocument"
                    android:text="@string/review_card_browser_document"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/reviewCardBrowserHeaderPage"
                    android:text="@string/review_card_browser_page"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/reviewCardBrowserHeaderSource"
                    android:text="@string/review_card_browser_source"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/reviewCardBrowserHeaderState"
                    android:text="@string/review_card_browser_state"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/reviewCardBrowserHeaderRepetitions"
                    android:text="@string/review_card_browser_repetitions"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />


            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/reviewCardBrowserHeaderDivider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:dividerColor="?attr/colorOnSurfaceVariant" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reviewCardBrowserList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                android:scrollbars="vertical" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/reviewCardBrowserMessagePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reviewCardBrowserSelectionCount">

        <TextView
            android:id="@+id/reviewCardBrowserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/review_card_browser_loading"
            android:textAlignment="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewCardBrowserRetry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/review_card_browser_retry"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
